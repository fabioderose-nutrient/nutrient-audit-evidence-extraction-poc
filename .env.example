# Nutrient license keys. Leave empty to run the SDKs in evaluation mode.
NUTRIENT_PYTHON_LICENSE_KEY=
NUTRIENT_WEB_SDK_LICENSE_KEY=

# LLM used by the structured extraction step (OpenAI, or a local model through Ollama).
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini
OLLAMA_URL=http://127.0.0.1:11434
LOCAL_MAX_TOKENS=1500
LOCAL_PRESENCE_PENALTY=0.6

# Server
PORT=8010
ALLOWED_ORIGINS=http://localhost:8010,http://127.0.0.1:8010
WORK_DIR=

# Nutrient SDK options
NUTRIENT_METADATA_SCHEMA=2
NUTRIENT_VLM_FULL_PAGE=0
